{
  "expo": {
    "name": "Invitely",
    "slug": "invitely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "invitely",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.invitely.app",
      "associatedDomains": ["applinks:invitely.replit.app"]
    },
    "android": {
      "package": "com.invitely.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "invitely.replit.app", "pathPrefix": "/e/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://invitely.replit.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Invitely to add photos from your library to invitations and the event gallery.",
          "cameraPermission": "Allow Invitely to capture event photos with your camera."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Invitely to read your contacts so you can pick people to invite. Contacts stay on this device — only those you invite are saved."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
